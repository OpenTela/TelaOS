# tela_dom.sim — the DOM for scripts on the real TelaOS engine (docs/DOM.md).
# Fixture: sim/tests/fixtures/apps/dom_tags (flashed with --extra-data sim/tests/fixtures).
# Its script reads and writes the page when it starts, a tap reads and writes a button.
# Page "classes": one tap toggles classes, and what their rules show and hide follows.
# Page "query": querySelectorAll finds the boxes checked now, and hides the odd rows.
# Page "style": style="" of a label shows, a tap sets el.style and the next takes it off.
# Page "events": listeners get a tap that goes up, one stopped, a link that stays.

wait 300
> app launch dom_tags
wait 800

expect "DOM" :visible
expect @readFmt "read: Hello bold world"
expect @readRich "read: Name (optional)"
expect @readItem "read: The item"
expect @readDet "read: MoreBody"
expect @spans "new text"
expect @gone :hidden
expect @tick on
expect @fixed "fixed"
expect @box "replaced"
shot dom_01_start

scroll @btn
tap "Tap"
wait 200
expect @btn "Tapped"
expect @readTap "read: BUTTON tap"

# {count} goes on writing the line the script left alone, not the one it wrote,
# and the box's old line is gone: nothing reaches it
scroll @add
tap "Add"
wait 200
expect @count "Count: 1"
expect @fixed "fixed"
expect @box "replaced"
shot dom_02_after

scroll @toClasses
tap "classList"
wait 300
expect "Classes" :visible
expect @panelBody :visible
expect @afterLead :visible
expect @step1 :visible
tap "Toggle"
wait 200
expect @readClass "read: lamp on boxed"
expect @panelBody :hidden
expect @afterLead :hidden
expect @step1 :hidden
expect @step2 :visible
shot dom_03_classes_on
tap "Toggle"
wait 200
expect @readClass "read: lamp"
expect @panelBody :visible
expect @afterLead :visible
expect @step1 :visible
shot dom_04_classes_off

scroll @toQuery
tap "querySelector"
wait 300
expect "Query" :visible
expect @q1 on
expect @q2 off
tap @q2
wait 200
expect @q2 on
scroll @find
tap "Find"
wait 200
expect @readQuery "read: q1 q2 / qi2"
expect @qi1 :hidden
expect @qi2 :visible
expect @qi3 :hidden
shot dom_05_query

scroll @toStyle
tap "el.style"
wait 300
expect "Style" :visible
expect @vanish :visible
tap @restyle
wait 200
expect @vanish :hidden
expect @readStyle "read: [color: #4FC3F7;] #FF8A65"
shot dom_06_style
tap @restyle
wait 200
expect @vanish :visible
expect @readStyle "read: [] #FF8A65"

scroll @toEvents
tap "addEventListener"
wait 300
expect "Events" :visible
tap @evBtn
wait 200
expect @readEvents "read: click evBtn > evCard"
tap @evStop
wait 200
expect @readEvents "read: stopped"
tap "this link stays"
wait 300
expect "Events" :visible
expect @readEvents "read: stayed"
shot dom_07_events

expect mem.dram_failed 0
expect mem.psram_failed 0

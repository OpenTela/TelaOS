<app version="1.2" category="game" icon="system:puzzle-game">
  <templates>
    <template id="Cell">
      <td><button id="c{r}{c}" onclick="tap({r},{c})" class="cell">{v{r}{c}}</button></td>
    </template>
    <template id="Row">
      <tr>
        <td w="25%"><button id="h{r}" onclick="sel({r})" class="text-muted">{hint{r}}</button></td>
        <Cell r="{r}" c="1"/>
        <Cell r="{r}" c="2"/>
        <Cell r="{r}" c="3"/>
      </tr>
    </template>
    <template id="Key">
      <td><button onclick="add('{letter}')" class="box-gray">{letter}</button></td>
    </template>
  </templates>

  <ui default="/main">
    <page id="main" bgcolor="#000">
      <!-- Сетка 3x3 с подсказками -->
      <table x="3%" y="8%" w="94%" h="55%" cellspacing="2">
        <Row r="0"/>
        <Row r="1"/>
        <Row r="2"/>
        <tr>
          <td w="25%"/>
          <td><label class="text-muted-2">{hint0}</label></td>
          <td><label class="text-muted-2">{hint1}</label></td>
          <td><label class="text-muted-2">{hint2}</label></td>
        </tr>
      </table>

      <!-- Клавиатура -->
      <table x="3%" y="78%" w="94%" h="8%" cellspacing="1%">
        <tr>
          <Key letter="К"/>
          <Key letter="О"/>
          <Key letter="Т"/>
          <Key letter="С"/>
          <Key letter="А"/>
          <td><button onclick="kDel" class="box-del">←</button></td>
        </tr>
      </table>

      <button x="35%" y="88%" onclick="nextW" w="30%" h="32" bgcolor="#4caf50" color="#fff">Дальше</button>
    </page>

    <page id="win" bgcolor="#000">
      <label align="center" y="35%" color="#4caf50" font="48">!</label>
      <label align="center" y="55%" color="#fff" font="32">Ура!</label>
      <button x="25%" y="75%" onclick="again" w="50%" h="44" bgcolor="#ff9500" color="#fff">Ещё</button>
    </page>
  </ui>

  <style>
    .box-gray { bgcolor: #505050; color: #fff; width: 100%; height: 100%; }
    .box-del { bgcolor: #a0a0a0; color: #000; width: 100%; height: 100%; }
    .cell { bgcolor: #333; color: #fff; width: 100%; height: 100%; radius: 0; }
    .text-muted { bgcolor: #1c1c1c; color: #888; font: 16; width: 100%; height: 100%; }
    .text-muted-2 { color: #888; font: 16; width: 100%; height: 100%; text-align: center; }
  </style>

  <state>
    <string name="hint0" default="Питомец"/>
    <string name="hint1" default="Жалит"/>
    <string name="hint2" default="Так"/>
    <string name="v01" default=""/><string name="v02" default=""/><string name="v03" default=""/>
    <string name="v11" default=""/><string name="v12" default=""/><string name="v13" default=""/>
    <string name="v21" default=""/><string name="v22" default=""/><string name="v23" default=""/>
  </state>

  <script language="lua">
    --[[
      МАГИЧЕСКИЙ КВАДРАТ 3x3
      Слова одинаковые по горизонтали и вертикали!

      [Питомец→] К  О  Т   [↓Питомец]
      [Жалит→  ] О  С  А   [↓Жалит]
      [Так→    ] Т  А  К   [↓Так]
    ]]

    local words = {
      {{{0,1},{0,2},{0,3}}, {"К","О","Т"}},
      {{{1,1},{1,2},{1,3}}, {"О","С","А"}},
      {{{2,1},{2,2},{2,3}}, {"Т","А","К"}},
      {{{0,1},{1,1},{2,1}}, {"К","О","Т"}},
      {{{0,2},{1,2},{2,2}}, {"О","С","А"}},
      {{{0,3},{1,3},{2,3}}, {"Т","А","К"}},
    }

    local CELL = "#333"
    local SEL = "#1a237e"
    local PART = "#1b4332"
    local OK = "#2e7d32"

    local done = {}
    for i = 1, 6 do done[i] = false end

    local cur = 1
    local pos = 1

    local function vk(r,c) return "v"..r..c end
    local function ci(r,c) return "c"..r..c end

    local function cntDone(r,c)
      local n = 0
      for i = 1, 6 do
        if done[i] then
          local wc = words[i][1]
          for j = 1, 3 do
            if wc[j][1]==r and wc[j][2]==c then n=n+1 break end
          end
        end
      end
      return n
    end

    local function cntAll(r,c)
      local n = 0
      for i = 1, 6 do
        local wc = words[i][1]
        for j = 1, 3 do
          if wc[j][1]==r and wc[j][2]==c then n=n+1 break end
        end
      end
      return n
    end

    local function chkW(i)
      local wc = words[i][1]
      local wl = words[i][2]
      for j = 1, 3 do
        if state[vk(wc[j][1],wc[j][2])] ~= wl[j] then return false end
      end
      return true
    end

    local function color(r,c)
      local d = cntDone(r,c)
      local a = cntAll(r,c)
      if d==0 then setAttr(ci(r,c),"bgcolor",CELL)
      elseif d<a then setAttr(ci(r,c),"bgcolor",PART)
      else setAttr(ci(r,c),"bgcolor",OK) end
    end

    local function chkAll()
      local all = true
      for i = 1, 6 do
        if chkW(i) then done[i]=true else all=false end
      end
      for r = 0, 2 do
        for c = 1, 3 do color(r,c) end
      end
      return all
    end

    local function clr()
      for r = 0, 2 do
        for c = 1, 3 do
          if cntDone(r,c)==0 then setAttr(ci(r,c),"bgcolor",CELL) end
        end
      end
    end

    local function hl()
      clr()
      if not done[cur] then
        local wc = words[cur][1]
        setAttr(ci(wc[pos][1],wc[pos][2]),"bgcolor",SEL)
      end
    end

    function tap(r,c)
      for i = 1, 6 do
        if not done[i] then
          local wc = words[i][1]
          for j = 1, 3 do
            if wc[j][1]==r and wc[j][2]==c then
              cur=i pos=j hl() return
            end
          end
        end
      end
    end

    function add(l)
      if done[cur] then return end
      local wc = words[cur][1]
      if pos <= 3 then
        state[vk(wc[pos][1],wc[pos][2])] = l
        if pos < 3 then pos=pos+1 end
        if chkAll() then ui.navigate("/win") return end
        hl()
      end
    end

    function kDel()
      if done[cur] then return end
      local wc = words[cur][1]
      local r,c = wc[pos][1],wc[pos][2]
      if state[vk(r,c)]=="" and pos>1 then pos=pos-1 r=wc[pos][1] c=wc[pos][2] end
      state[vk(r,c)]="" hl()
    end

    function nextW()
      local st = cur
      repeat
        cur = cur+1
        if cur > 6 then cur=1 end
        if not done[cur] then pos=1 hl() return end
      until cur==st
    end

    function sel(row)
      cur = row + 1
      pos = 1
      hl()
    end

    function again()
      for i=1,6 do done[i]=false end
      for r=0,2 do
        for c=1,3 do
          state[vk(r,c)]=""
          setAttr(ci(r,c),"bgcolor",CELL)
        end
      end
      cur=1 pos=1 ui.navigate("/main") hl()
    end

    hl()
  </script>
</app>

<app os="1.0" title="DOM" version="0.1" category="test">
  <!--
    Test fixture for the DOM in TelaOS (docs/DOM.md): document.getElementById, textContent,
    getAttribute, setAttribute, removeAttribute (page "main"); classList (page "classes");
    querySelector and querySelectorAll (page "query"); el.style and style="" (page "style").
    Flashed by the simulator with --extra-data; driven by tests/tela_dom.sim. The script runs
    when the app starts: a line "read: ..." shows what it read, the others show what it wrote.
  -->
  <style>
    .on { color: #FFD54F; }
    .boxed { border: 2px solid #4FC3F7; }
    .collapsed .body { display: none; }
    .lead + p { display: none; }
    .short li:first-child { display: none; }
    .off { display: none; }
  </style>
  <ui default="/main">
    <page id="main">
      <h2>DOM</h2>
      <p id="toClasses"><a href="/classes">classList</a></p>
      <p id="fmt">Hello <b>bold</b> world</p>
      <p id="readFmt">-</p>
      <label id="rich">Name <i>(optional)</i></label>
      <p id="readRich">-</p>
      <ul><li id="item">The item</li></ul>
      <p id="readItem">-</p>
      <details id="det"><summary>More</summary><p>Body</p></details>
      <p id="readDet">-</p>
      <p id="spans">old <i>words</i> here</p>
      <p id="gone">this line hides</p>
      <p id="count">Count: {count}</p>
      <p id="fixed">Count: {count}</p>
      <div id="box"><p>Inside: {count}</p><label>two</label></div>
      <input type="checkbox" id="tick" label="Remember">
      <button id="btn" onclick="tap">Tap</button>
      <p id="readTap">-</p>
      <button id="add" onclick="add">Add</button>
    </page>

    <page id="classes">
      <h2>Classes</h2>
      <label id="lamp" class="lamp">.on: yellow, .boxed: a frame</label>
      <p id="readClass">-</p>
      <div id="panel"><p id="panelBody" class="body">.collapsed .body: hidden</p></div>
      <p id="leadP">the first line</p><p id="afterLead">.lead + p: hidden</p>
      <ul id="steps"><li id="step1">.short li:first-child: hidden</li><li id="step2">the second item</li></ul>
      <button id="toggle" onclick="toggleAll">Toggle</button>
      <p id="toQuery"><a href="/query">querySelector</a></p>
      <a href="/main">Back</a>
    </page>

    <page id="query">
      <h2>Query</h2>
      <input type="checkbox" id="q1" label="One" checked>
      <input type="checkbox" id="q2" label="Two">
      <input type="checkbox" id="q3" label="Three">
      <ul id="qlist"><li id="qi1">the first</li><li id="qi2">the second</li><li id="qi3">the third</li></ul>
      <button id="find" onclick="findChecked">Find</button>
      <p id="readQuery">-</p>
      <p id="toStyle"><a href="/style">el.style</a></p>
      <a href="/main">Back</a>
    </page>

    <page id="style">
      <h2>Style</h2>
      <label id="painted" style="color: #FF8A65">style="": orange</label>
      <p id="styled">el.style.color: this line</p>
      <label id="vanish">el.style.display: none hides it</label>
      <button id="restyle" onclick="restyle">Restyle</button>
      <p id="readStyle">-</p>
      <a href="/main">Back</a>
    </page>
  </ui>
  <state>
    <int name="count" default="0"/>
  </state>
  <script language="lua">
local function el(id) return document.getElementById(id) end

el("readFmt").textContent = "read: " .. el("fmt").textContent
el("readRich").textContent = "read: " .. el("rich").textContent
el("readItem").textContent = "read: " .. el("item").textContent
el("readDet").textContent = "read: " .. el("det").textContent
el("spans").textContent = "new text"
el("gone"):setAttribute("hidden", "")
el("fixed").textContent = "fixed"
el("box").textContent = "replaced"
el("tick"):setAttribute("checked", "")

function tap()
  local b = el("btn")
  b.textContent = "Tapped"
  el("readTap").textContent = "read: " .. b.tagName .. " " .. b:getAttribute("onclick")
end

function add()
  state.count = state.count + 1
end

function toggleAll()
  local lamp = el("lamp")
  lamp.classList:toggle("on")
  lamp.classList:toggle("boxed")
  el("panel").classList:toggle("collapsed")
  el("leadP").classList:toggle("lead")
  el("steps").classList:toggle("short")
  el("readClass").textContent = "read: " .. lamp.className
end

-- The boxes checked now, then the odd rows hidden with a class
function findChecked()
  local ids = {}
  for _, c in ipairs(document:querySelectorAll("#query input:checked")) do ids[#ids + 1] = c.id end
  for _, li in ipairs(document:querySelectorAll("#qlist li:nth-child(odd)")) do li.classList:add("off") end
  local shown = document.getElementById("qlist"):querySelector("li:not(.off)")
  el("readQuery").textContent = "read: " .. table.concat(ids, " ") .. " / " .. shown.id
end

-- el.style: a color and display: none; the next tap takes both off
function restyle()
  local s, v = el("styled").style, el("vanish").style
  local on = v.display ~= "none"
  s.color = on and "#4FC3F7" or ""
  v.display = on and "none" or ""
  el("readStyle").textContent = "read: [" .. el("styled"):getAttribute("style") .. "] " .. el("painted").style.color
end
  </script>
</app>

<app title="dice" version="1.0" os="1.0" category="game">
  <ui default="/main">
    <page id="main" bgcolor="#1a1a2e">
      <label align="center" y="8%" color="#ffffff" font="24">The Cubic</label>
      <label align="center" y="40%" color="#f1c40f" font="72">{result}</label>
      <button align="center" y="70%" class="btn" onclick="roll" w="70%" h="60">БРОСИТЬ</button>
    </page>
  </ui>
  <state>
    <string name="result" default="?"/>
  </state>
  <script language="lua">
    local wordsRu = {"ОДИН", "ДВА", "ТРИ", "ЧЕТЫРЕ", "ПЯТЬ", "ШЕСТЬ"}
    local wordsEn = {"ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX"}
    function roll()
      local n = math.random(1, 6)
      local mode = math.random(1, 3)
      if mode == 1 then
        state.result = wordsRu[n]
      elseif mode == 2 then
        state.result = wordsEn[n]
      else
        state.result = tostring(n)
      end
    end
  </script>
  <style>
    .btn { background: #e74c3c; color: #ffffff; border-radius: 16px; font-size: 24px; }
  </style>
</app>
<app>
  <ui default="/main">
    <page id="main">
      <label align="center" y="20" color="#fff" font="32">QR Generator</label>

      <!-- Live QR: re-renders whenever state.payload changes -->
      <qr align="center" y="70" size="220" dark="#000000" light="#ffffff">{payload}</qr>

      <label align="center" y="320" color="#aaa" font="16">{payload}</label>

      <button align="center" y="370" w="60%" h="48" bgcolor="#3498db" onclick="genWifi">WiFi QR</button>
      <button align="center" y="430" w="60%" h="48" bgcolor="#2ecc71" onclick="genUrl">Project URL</button>
    </page>
  </ui>

  <state>
    <string name="payload" default="https://github.com/OpenTela/TelaOS"/>
  </state>

  <script language="lua">
    -- WiFi join QR per the standard WIFI: schema
    function genWifi()
      state.payload = "WIFI:T:WPA;S:TelaNet;P:supersecret;;"
    end

    function genUrl()
      state.payload = "https://github.com/OpenTela/TelaOS"
    end
  </script>
</app>

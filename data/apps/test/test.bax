<app>
  <ui default="/main">
    <page id="main" bgcolor="#000">
      <!-- 1: Эталон -->
      <label x="2%" y="1%" color="#888" font="16">1. Absolute:</label>
      <button id="a1" x="2%" y="5%" w="23%" h="32" bgcolor="#505050">A1</button>
      <button id="a2" x="27%" y="5%" w="23%" h="32" bgcolor="#505050">A2</button>
      <button id="a3" x="52%" y="5%" w="23%" h="32" bgcolor="#505050">A3</button>
      <button id="a4" x="77%" y="5%" w="23%" h="32" bgcolor="#ff9500">A4</button>

      <!-- 2: Кнопка без размера (работало) -->
      <label x="2%" y="12%" color="#888" font="16">2. No size:</label>
      <table x="2%" y="16%" w="96%">
        <tr>
          <td w="25%"><button id="n1" bgcolor="#505050">N1</button></td>
          <td w="25%"><button id="n2" bgcolor="#505050">N2</button></td>
          <td w="25%"><button id="n3" bgcolor="#505050">N3</button></td>
          <td w="25%"><button id="n4" bgcolor="#ff9500">N4</button></td>
        </tr>
      </table>

      <!-- 3: w=100% (ломалось) -->
      <label x="2%" y="24%" color="#888" font="16">3. w=100%:</label>
      <table x="2%" y="28%" w="96%">
        <tr>
          <td w="25%"><button id="b1" w="100%" h="32" bgcolor="#505050">B1</button></td>
          <td w="25%"><button id="b2" w="100%" h="32" bgcolor="#505050">B2</button></td>
          <td w="25%"><button id="b3" w="100%" h="32" bgcolor="#505050">B3</button></td>
          <td w="25%"><button id="b4" w="100%" h="32" bgcolor="#ff9500">B4</button></td>
        </tr>
      </table>

      <!-- 4: tr w=100% + td w=25% + button w=100% -->
      <label x="2%" y="36%" color="#888" font="16">4. tr100%:</label>
      <table x="2%" y="40%" w="96%">
        <tr w="100%">
          <td w="25%"><button id="r1" w="100%" h="32" bgcolor="#505050">R1</button></td>
          <td w="25%"><button id="r2" w="100%" h="32" bgcolor="#505050">R2</button></td>
          <td w="25%"><button id="r3" w="100%" h="32" bgcolor="#505050">R3</button></td>
          <td w="25%"><button id="r4" w="100%" h="32" bgcolor="#ff9500">R4</button></td>
        </tr>
      </table>

      <!-- 5: td пиксели + button w=100% -->
      <label x="2%" y="48%" color="#888" font="16">5. td px:</label>
      <table x="2%" y="52%" w="96%">
        <tr>
          <td w="115"><button id="p1" w="100%" h="32" bgcolor="#505050">P1</button></td>
          <td w="115"><button id="p2" w="100%" h="32" bgcolor="#505050">P2</button></td>
          <td w="115"><button id="p3" w="100%" h="32" bgcolor="#505050">P3</button></td>
          <td w="115"><button id="p4" w="100%" h="32" bgcolor="#ff9500">P4</button></td>
        </tr>
      </table>

      <!-- 6: td w=25% h=32 + button без размера -->
      <label x="2%" y="60%" color="#888" font="16">6. td sized:</label>
      <table x="2%" y="64%" w="96%">
        <tr>
          <td w="25%" h="32"><button id="s1" bgcolor="#505050">S1</button></td>
          <td w="25%" h="32"><button id="s2" bgcolor="#505050">S2</button></td>
          <td w="25%" h="32"><button id="s3" bgcolor="#505050">S3</button></td>
          <td w="25%" h="32"><button id="s4" bgcolor="#ff9500">S4</button></td>
        </tr>
      </table>

      <!-- 7: tr w=100% + td без w + button w=100 px -->
      <label x="2%" y="72%" color="#888" font="16">7. tr100 nw:</label>
      <table x="2%" y="76%" w="96%">
        <tr w="100%">
          <td><button id="x1" w="110" h="32" bgcolor="#505050">X1</button></td>
          <td><button id="x2" w="110" h="32" bgcolor="#505050">X2</button></td>
          <td><button id="x3" w="110" h="32" bgcolor="#505050">X3</button></td>
          <td><button id="x4" w="110" h="32" bgcolor="#ff9500">X4</button></td>
        </tr>
      </table>

      <!-- 8: table h задана + tr + td + button w/h=100% -->
      <label x="2%" y="84%" color="#888" font="16">8. full%:</label>
      <table x="2%" y="88%" w="96%" h="10%">
        <tr w="100%" h="100%">
          <td w="25%" h="100%"><button id="f1" w="100%" h="100%" bgcolor="#505050">F1</button></td>
          <td w="25%" h="100%"><button id="f2" w="100%" h="100%" bgcolor="#505050">F2</button></td>
          <td w="25%" h="100%"><button id="f3" w="100%" h="100%" bgcolor="#505050">F3</button></td>
          <td w="25%" h="100%"><button id="f4" w="100%" h="100%" bgcolor="#ff9500">F4</button></td>
        </tr>
      </table>
    </page>
  </ui>

  <style>
    button { color: #fff; }
  </style>

  <state/>
  <script language="lua"></script>
</app>

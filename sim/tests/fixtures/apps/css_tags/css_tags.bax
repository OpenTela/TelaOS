<app os="1.0" title="CSS" version="0.1" category="test">
  <!--
    Test fixture for CSS in TelaOS (docs/CSS.md): selectors and cascade; values (page "values");
    the box (page "box"); layout (page "layout"); text (page "text"); states (page "states");
    structure and screen (page "structure"); :not(), :is(), ::placeholder (page "pseudo").
    Flashed by the simulator with --extra-data; driven by tests/tela_css.sim.
    Each line says which rule colors it; a line in white did not get its rule.
  -->
  <style>
    h1, h2 { color: #4FC3F7; }
    nav a { color: #FFD54F; }
    .menu > li { color: #81C784; }
    ul li li { color: #FF8A65; }
    .card label { color: #CE93D8; }
    a:has(img), .ok { color: #E57373; }
    [data-tone="warn"] { color: #FFD54F; }
    a[href^="http"] { color: #AAAAAA; }
    #main .big { font-size: 32px; }
    p.note { color: #81C784; }
    .note { color: #E57373; }
    .must { color: #4FC3F7 !important; }
    #strong { color: #E57373; }
    .gone { display: none; }
    :root { --accent: #FFD54F; }
    .half { color: rgba(255, 255, 255, 0.5); }
    .hsl { color: hsl(200, 80%, 60%); }
    .accent { color: var(--accent); }
    .fallback { color: var(--none, #81C784); }
    .pad { padding: 4px 24px; background: #333333; }
    .tint { background: #4FC3F780; }
    .wide { width: 50vw; background: #333333; }
    .gap { gap: 8px 24px; }
    .dot { width: 2.5rem; height: 2.5rem; background: #E57373; border-radius: 50%; }
    .framed { border: 2px solid #4FC3F7; padding: 4px 8px; margin: 6px 0; }
    .under { border-bottom: 3px solid #FFD54F; }
    .ring { outline: 2px solid #81C784; outline-offset: 3px; margin: 8px; }
    .lifted { background: #333333; box-shadow: 0 6px 12px 2px rgba(79, 195, 247, 0.7); padding: 4px; margin: 4px 0 16px; }
    .sky { background: linear-gradient(to right, #4FC3F7, #283593); height: 32px; }
    .clip { overflow: hidden; height: 24px; background: #333333; }
    .bar { display: flex; justify-content: space-between; width: 100%; background: #333333; }
    .stack { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%; }
    .grower { width: 100%; gap: 8px; }
    .fill { flex: 1; background: #283593; }
    .frame { width: 100%; height: 56px; background: #333333; }
    .corner { position: absolute; right: 8px; bottom: 8px; color: #FFD54F; }
    .nudge { position: relative; left: 24px; }
    .ghost { visibility: hidden; }
    .tdeco { text-decoration: underline; }
    .tstrike { text-decoration: line-through; color: #AAAAAA; }
    .spaced { letter-spacing: 3px; }
    .airy { line-height: 1.8; }
    .tdots { width: 220px; white-space: nowrap; text-overflow: ellipsis; color: #FFD54F; }
    .mid { text-align: center; }
    .end { text-align: right; }
    .tick:checked { outline: 3px solid #81C784; }
    .dimmed:disabled { opacity: 0.4; }
    .press { background: #333333; transition: background-color 0.3s ease; }
    .press:active { background: #4FC3F7; transform: scale(0.95); }
    .tilted { transform: rotate(-6deg); color: #FFD54F; margin: 12px 0; }
    @media (max-width: 500px) { .narrow { color: #81C784; } }
    .bigscreen { display: none; }
    @media (min-width: 600px) { .bigscreen { display: block; } }
    .zebra li:nth-child(odd) { background: #333333; }
    .zebra li:last-child { color: #FFD54F; }
    #structure h3 ~ p { color: #FF8A65; }
    #structure h3 + p { color: #4FC3F7; }
    .sep li:not(:last-child) { border-bottom: 1px solid #4FC3F7; }
    .tag:is(.hot, .new) { color: #E57373; }
    .tag:not(:is(.hot, .new)) { color: #AAAAAA; }
    .hinted::placeholder { color: #81C784; }
  </style>
  <ui default="/main">

    <page id="main">
      <h1>Selectors</h1>
      <h2>h1, h2: one rule</h2>
      <nav id="links"><p><a href="/more">nav a: yellow</a> <a href="/more">More</a></p></nav>
      <ul class="menu">
        <li id="direct">.menu &gt; li: green
          <ul><li id="nested">ul li li: orange</ul>
      </ul>
      <div class="card"><label id="inCard">.card label: violet</label></div>
      <p class="ok" id="ok">a:has(img), .ok: red</p>
      <p data-tone="warn" id="warn">[data-tone=warn]: yellow</p>
      <p id="ext"><a href="https://example.com">a[href^=http]: grey</a></p>
      <p class="big" id="big">#main .big</p>
      <p class="note" id="note">p.note beats .note: green</p>
      <p class="must" id="strong">!important beats #id: blue</p>
      <p class="gone" id="gone">display: none</p>
      <p id="pages"><a href="/values">Values</a> <a href="/box">Box</a> <a href="/layout">Layout</a> <a href="/text">Text</a> <a href="/states">States</a> <a href="/structure">Structure</a> <a href="/pseudo">Pseudo</a></p>
    </page>

    <page id="values">
      <h2>Values</h2>
      <p class="half" id="half">rgba(): half white</p>
      <p class="hsl" id="hsl">hsl(): sky blue</p>
      <p class="accent" id="accent">var(--accent): yellow</p>
      <p class="fallback" id="fallback">var(--none, green): green</p>
      <p class="pad" id="pad">padding: 4px 24px</p>
      <p class="tint" id="tint">#4FC3F780: see-through blue</p>
      <div class="wide" id="wide"><label>width: 50vw</label></div>
      <div flex="row" class="gap" id="gap"><label>gap</label><label>8px</label><label>24px</label></div>
      <div class="dot" id="dot"></div>
      <p><a href="/main">Back</a></p>
    </page>

    <page id="box">
      <h2>Box</h2>
      <p class="framed" id="framed">border: 2px solid blue</p>
      <p class="under" id="under">border-bottom: yellow line</p>
      <p class="ring" id="ring">outline with offset: green</p>
      <p class="lifted" id="lifted">box-shadow: lifted</p>
      <div class="sky" id="sky"><label>linear-gradient: to right</label></div>
      <div class="clip" id="clip" flex="column"><label>overflow: hidden, first line</label><label>second line, cut off</label></div>
      <p><a href="/main">Back</a></p>
    </page>

    <page id="layout">
      <h2>Layout</h2>
      <div class="bar" id="bar"><label>left</label><label>middle</label><label>right</label></div>
      <div class="stack" id="stack"><label>1</label><label>2</label><label>3</label></div>
      <div class="grower" id="grower" flex="row"><label class="fill" id="fill">flex: 1</label><label>fixed</label></div>
      <div class="frame" id="frame"><label class="corner" id="corner">absolute: bottom right</label></div>
      <p class="nudge" id="nudge">relative: 24px to the right</p>
      <p class="ghost" id="ghost">visibility: hidden</p>
      <p id="after">after the hidden line</p>
      <p><a href="/main">Back</a></p>
    </page>

    <page id="text">
      <h2>Text</h2>
      <p class="tdeco" id="tdeco">text-decoration: underline</p>
      <p class="tstrike" id="tstrike">text-decoration: line-through</p>
      <p class="spaced" id="spaced">letter-spacing: 3px</p>
      <p class="airy" id="airy">line-height: 1.8 on a paragraph that is long enough to wrap onto a second line</p>
      <label class="tdots" id="tdots">text-overflow: ellipsis cuts this long line with dots</label>
      <p class="mid" id="midRow"><input type="checkbox" id="midBox"> text-align: center <button>with a button</button></p>
      <div class="end"><p id="endRow"><input type="checkbox" id="endBox"> right, from the div</p></div>
      <p class="mid" dir="rtl" id="rtlRow"><input type="checkbox" id="rtlBox"> rtl, center</p>
      <p><a href="/main">Back</a></p>
    </page>

    <page id="states">
      <h2>States</h2>
      <p><input type="checkbox" class="tick" id="tick"> :checked: a green ring</p>
      <button class="dimmed" id="dimmed" disabled>:disabled: faded</button>
      <button class="press" id="press">:active: blue while pressed</button>
      <label class="tilted" id="tilted">transform: rotate(-6deg)</label>
      <p><a href="/main">Back</a></p>
    </page>

    <page id="structure">
      <h2>Structure</h2>
      <p class="narrow" id="narrow">@media (max-width: 500px): green</p>
      <p class="bigscreen" id="bigscreen">@media (min-width: 600px): hidden on 480px</p>
      <ul class="zebra" id="zebra">
        <li>li:nth-child(odd): a stripe</li>
        <li>two</li>
        <li>three</li>
        <li id="lastli">li:last-child: yellow</li>
      </ul>
      <h3>h3</h3>
      <p id="nextp">h3 + p: blue</p>
      <p id="laterp">h3 ~ p: orange</p>
      <a href="/main">Back</a>
    </page>

    <page id="pseudo">
      <h2>Pseudo</h2>
      <ul class="sep" id="sep">
        <li>li:not(:last-child): a line under</li>
        <li>two</li>
        <li id="lastsep">the last: no line</li>
      </ul>
      <p class="tag hot" id="hot">.tag:is(.hot, .new): red</p>
      <p class="tag" id="plaintag">.tag:not(:is(.hot, .new)): grey</p>
      <input class="hinted" id="hinted" w="80%" placeholder="::placeholder: a green hint">
      <a href="/main">Back</a>
    </page>

    <page id="more">
      <p class="big" id="big2">.big, not on #main: small</p>
      <p><a href="/main">Back</a></p>
    </page>

  </ui>
</app>

# tela_css.sim — CSS selectors and cascade on the real TelaOS engine (docs/CSS.md).
# Fixture: sim/tests/fixtures/apps/css_tags (flashed with --extra-data sim/tests/fixtures).
# Colors are seen on the screenshots, the checks below are about what the rules show, hide and size.

wait 300
> app launch css_tags
wait 800

expect "Selectors" :visible
expect @links "nav a: yellow More"
expect @direct contains ".menu > li: green"
expect @nested contains "ul li li: orange"
expect @inCard ".card label: violet"
expect @gone :hidden
expect "display: none" :hidden
shot css_01_selectors

tap "More"
wait 200
expect @big2 ".big, not on #main: small"
shot css_02_other_page
tap "Back"
wait 200
expect "Selectors" :visible

tap "Values"
wait 200
expect "rgba(): half white" :visible
expect @accent "var(--accent): yellow"
expect @fallback "var(--none, green): green"
expect @gap "gap 8px 24px"
expect @dot :visible
shot css_03_values
tap "Back"
wait 200
expect "Selectors" :visible

tap "Box"
wait 200
expect @framed "border: 2px solid blue"
expect @lifted "box-shadow: lifted"
expect @sky "linear-gradient: to right"
expect "overflow: hidden, first line" :visible
shot css_04_box
tap "Back"
wait 200
expect "Selectors" :visible

tap "Layout"
wait 200
expect @bar "left middle right"
expect @stack "1 2 3"
expect "absolute: bottom right" :visible
expect @after "after the hidden line"
shot css_05_layout
tap "Back"
wait 200
expect "Selectors" :visible

tap "Text"
wait 200
expect @tdeco "text-decoration: underline"
expect @spaced "letter-spacing: 3px"
expect @tdots :visible
shot css_06_text
tap "Back"
wait 200
expect "Selectors" :visible
